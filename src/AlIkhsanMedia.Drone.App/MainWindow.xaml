<Window x:Class="AlIkhsanMedia.Drone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Al Ikhsan Media (Drone Version)" Width="1200" Height="760" MinWidth="1100" MinHeight="700"
        Background="#111513" Foreground="#F4F7F5" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#1F9D68"/><Setter Property="BorderBrush" Value="#1F9D68"/></Style>
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,24"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Al Ikhsan Media" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Drone Version" Foreground="#AEBAB3" FontSize="15"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="ENGINE" Foreground="#AEBAB3" FontSize="11"/><TextBlock x:Name="EngineStatus" Text="Memulai pemeriksaan…" Foreground="#E7A83E"/><TextBlock x:Name="EngineMessage" Foreground="#AEBAB3" TextWrapping="Wrap" MaxWidth="420"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#181E1B" BorderBrush="#344039" BorderThickness="1" Padding="18" Margin="0,0,0,20"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Pilih slot untuk melihat URL dan status stream." Foreground="#AEBAB3"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Panduan Setup" Click="ShowGuide"/><Button Content="Diagnostik" Click="ShowDiagnostics" Background="#202823"/></StackPanel></DockPanel></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#181E1B" BorderBrush="#344039" BorderThickness="1" Padding="18" Margin="0,0,14,14"><StackPanel><DockPanel><TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="#E7A83E" FontSize="12"/></DockPanel><TextBlock Text="{Binding StateText}" Foreground="#AEBAB3" Margin="0,16,0,16" TextWrapping="Wrap"/><TextBlock Text="Untuk DJI Fly — kirim video ke laptop" Foreground="#AEBAB3" FontSize="12"/><TextBox Text="{Binding RtmpUrl}" IsReadOnly="True" Background="#202823" Foreground="#AEBAB3" Padding="8"/><Button Content="Salin URL RTMP" Click="CopyRtmp" AutomationProperties.Name="Salin URL RTMP" HorizontalAlignment="Left"/><Button Content="Simpan QR Setup" Click="SaveQr" AutomationProperties.Name="Simpan QR Setup" HorizontalAlignment="Left"/><TextBlock Text="Untuk vMix — ambil video dari laptop" Foreground="#AEBAB3" FontSize="12" Margin="0,4,0,0"/><TextBox Text="{Binding RtspUrl}" IsReadOnly="True" Background="#202823" Foreground="#AEBAB3" Padding="8"/><Button Content="Salin URL vMix" Click="CopyRtsp" AutomationProperties.Name="Salin URL vMix" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="Tidak ada koneksi internet wajib. Video tetap lokal dan tidak ada overlay pada frame." Foreground="#AEBAB3"/><TextBlock x:Name="CopyMessage" DockPanel.Dock="Right" Text="" Foreground="#1F9D68"/></DockPanel>
  </Grid>
</Window>
